# -----------------------------------------------------------------------------
# E Michelin e Cia — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e cadastre na Vercel (produção).
# Sem as variáveis do Supabase a loja roda em MODO DEMONSTRAÇÃO (catálogo local).
# -----------------------------------------------------------------------------

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# ⚠️ Somente no servidor. Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Mercado Pago (Suas integrações → Credenciais). Use as de TESTE em desenvolvimento.
NEXT_PUBLIC_MP_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000
# Webhooks → "Assinatura secreta" (usada para validar o header x-signature)
MP_WEBHOOK_SECRET=

# Resend (e-mails transacionais) — o domínio do remetente precisa estar verificado
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="E Michelin e Cia <pedidos@seudominio.com.br>"
STORE_NOTIFICATION_EMAIL=vendas@seudominio.com.br

# WhatsApp Cloud API (opcional — sem isso as mensagens só aparecem no log)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Número da loja que recebe alertas de novos orçamentos (DDI+DDD+número, só dígitos)
STORE_WHATSAPP_NOTIFY=

# Dados públicos da loja (TODO: confirmar com a E Michelin)
NEXT_PUBLIC_WHATSAPP_NUMBER=5554999999999
NEXT_PUBLIC_STORE_EMAIL=contato@seudominio.com.br
NEXT_PUBLIC_STORE_CNPJ=00.000.000/0001-00
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/
NEXT_PUBLIC_FOUNDED_YEAR=1985
